# ==========================================================
# 运行时数据（切勿入库）
# ----------------------------------------------------------
# data/autospeed.db 会在运行时写入企业微信 corpid/secret/agentid、
# 面板登录密码、session_secret 等敏感配置，一旦提交即泄露。
# 应用启动时由 init_db() 自动建表，无需随仓库分发。
# ==========================================================
data/

# Ookla license 缓存（每台机器自己生成）
ookla-config/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# 日志与临时文件
*.log
*.tmp
